# ==============================================================================
# ACIS — .gitignore
#
# Rule: ignore only what is (a) secret, (b) machine-local, or (c) regenerable.
# Versioned knowledge stays tracked — docs/ context/ reports/ agents/
# benchmarks/ evals/ experiments/ scripts/ src/ tests/ storage/ trace/.
# Kept in sync with pytest.ini (norecursedirs) and .dockerignore.
# ==============================================================================

# ------------------------------------------------------------------- secrets
.env
.env.*
!.env.example

# ---------------------------------------------------------------- Python env
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
build/
dist/
node_modules/
*.egg-info/
.eggs/

# Python tooling caches (regenerable)
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/
.streamlit/
# -------------------------------------------------- local data & run output
# Host-only datasets and databases — see pytest.ini and .dockerignore
data/
logs/
results/
benchmarks/
context/
docs/
reports/
# Pytest temp roots (pytest-of-<user>) and the torch inductor cache
pytest-of-*/
torchinductor_lkl/
web/pytest-of-*/
# FUSE mount leftovers observed under data/
.fuse_hidden*

# Local cleanup archives and audit copies kept outside the repo
.local-archive/
acis-local-archive/
reports/document_cleanup_manifest.csv

# Ad-hoc trace dumps (collector output)
trace_*.json

# ------------------------------------------ generated eval / E2E test output
# Delivery-eval SQLite database (regenerable; default runtime DBs live in data/)
acis_delivery_eval.db
*.db-wal
*.db-shm
*.db-journal

# Playwright / web E2E evidence and caches (regenerated by npm run test:e2e)
reports/web-e2e-*/
web/test-results/
web/playwright-report/
web/.playwright/

# ------------------------------------------------------------- Neo4j (docker)
# /data lives in the neo4j_data named volume; these host dirs are runtime-only
neo4j/logs/
neo4j/import/
neo4j/plugins/
neo4j/data/
neo4j/dumps/
neo4j/run/

# ------------------------------------------------- agent / cowork tool state
.claude/
.codex/
.context/
.acis-ui-smoke-local/
.acis_delivery_eval_verify_20261119/
# ---------------------------------------------------------- editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
._*

# ----------------------------------------------------------- misc scratch
*.log
*.tmp
*.bak
