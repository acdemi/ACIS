# ==============================================================================
# ACIS — .gitignore
#
# Rule: ignore only what is (a) secret, (b) machine-local, or (c) regenerable.
# Versioned knowledge stays tracked — docs/ context/ reports/ agents/
# benchmarks/ evals/ experiments/ scripts/ src/ tests/ storage/ trace/.
# Kept in sync with pytest.ini (norecursedirs) and .dockerignore.
# ==============================================================================

# ------------------------------------------------------------------- secrets
.env
.env.*
!.env.example

# ---------------------------------------------------------------- Python env
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
env/
build/
dist/
*.egg-info/
.eggs/

# Python tooling caches (regenerable)
.mypy_cache/
.ruff_cache/
.pytest_cache/
.tox/
.nox/
.coverage
.coverage.*
coverage.xml
htmlcov/

# -------------------------------------------------- local data & run output
# Host-only datasets and databases — see pytest.ini and .dockerignore
data/
logs/
results/

# Pytest temp roots (pytest-of-<user>) and the torch inductor cache
pytest-of-*/
torchinductor_lkl/

# FUSE mount leftovers observed under data/
.fuse_hidden*

# Local cleanup archives and audit copies kept outside the repo
.local-archive/
acis-local-archive/
reports/document_cleanup_manifest.csv

# Ad-hoc trace dumps (collector output)
trace_*.json

# ------------------------------------------------------------- Neo4j (docker)
# /data lives in the neo4j_data named volume; these host dirs are runtime-only
neo4j/logs/
neo4j/import/
neo4j/plugins/
neo4j/data/
neo4j/dumps/
neo4j/run/

# ------------------------------------------------- agent / cowork tool state
.claude/
.codex/
.context/

# ---------------------------------------------------------- editors and OS
.vscode/
.idea/
*.swp
*~
.DS_Store
Thumbs.db
Desktop.ini
._*

# ----------------------------------------------------------- misc scratch
*.log
*.tmp
*.bak
