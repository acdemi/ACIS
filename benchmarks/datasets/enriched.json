{
  "name": "enriched",
  "description": "面向真实认知挑战的扩展案例集：信息缺失、矛盾证据、多病害、稀有知识与传感器冲突。",
  "cases": [
    {
      "id": "mi_tomato_growth_slow",
      "query": "温室A番茄近期生长缓慢，叶片颜色偏淡，需要补充哪些信息才能判断是否染病？",
      "ground_truth": "证据不足",
      "expected_confidence_range": [0.5, 0.75],
      "expected_tools": ["image_capture"],
      "metadata": {
        "challenge_type": "missing_information",
        "expected_reasoning_features": ["information_request"],
        "difficulty": 2,
        "crop": "tomato",
        "disease": null,
        "noise_level": "low",
        "modalities": ["text"],
        "design_intent": "missing_information: 验证症状信息缺失时系统主动请求补充信息"
      }
    },
    {
      "id": "mi_sugar_beet_partial",
