# ACIS local configuration template.
# Copy to `.env` (gitignored) and fill only what you need. The core text
# pipeline runs fully offline without any key; the LLM Judge/Critic path is
# optional.

# ---------------------------------------------------------------------------
# Optional LLM Judge / Critic (OpenAI-compatible endpoint)
# ---------------------------------------------------------------------------
# Judge-specific variables take precedence over the legacy DEEPSEEK_* names.
# Leave empty to keep the deterministic rules path (default).
AGRI_AI_JUDGE_API_KEY=
AGRI_AI_JUDGE_BASE_URL=https://api.deepseek.com
AGRI_AI_JUDGE_PROVIDER=
AGRI_AI_JUDGE_MODEL=deepseek-chat
# Per-request timeout (seconds, max 300) and SDK retry budget (max 5).
AGRI_AI_JUDGE_TIMEOUT_SECONDS=60
AGRI_AI_JUDGE_MAX_RETRIES=2
# ADR-005 self-consistency sampling: number of Judge samples (1 disables).
AGRI_AI_JUDGE_SELF_CONSISTENCY_K=3
# Legacy aliases still honored when the AGRI_AI_JUDGE_* variable is empty:
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
# If you use the opencode zen gateway, map its values manually (the code does
# not read OPENCODE_* directly):
#   AGRI_AI_JUDGE_BASE_URL=https://opencode.ai/zen/go/v1
#   AGRI_AI_JUDGE_API_KEY=<your opencode key>
#   AGRI_AI_JUDGE_MODEL=deepseek-v4.1-flash

# Optional LLM Critic rebuttal model (defaults to DEEPSEEK_MODEL).
AGRI_AI_CRITIC_MODEL=
# Multi-round debate (default on) and the optional economy/ecology experts.
AGRI_AI_MULTI_ROUND_DEBATE=1
AGRI_AI_EXTRA_EXPERTS=1
# ADR-005 aggregation: memory relevance gate and abstention floor.
AGRI_AI_MEMORY_GATE=1
AGRI_AI_MEMORY_GATE_MIN_CONF=0.45

# ---------------------------------------------------------------------------
# Runtime / storage
# ---------------------------------------------------------------------------
# SQLite decision audit log (created on first use). Set PERSIST=0 to disable.
AGRI_AI_PERSIST=1
AGRI_AI_DB_PATH=data/agri.db
# Optional Planner + Tool Router (both default off; the router never executes).
ACIS_ENABLE_PLANNER=0

# ---------------------------------------------------------------------------
# Optional external services (all have in-process fallbacks)
# ---------------------------------------------------------------------------
AGRI_AI_RAG_BACKEND=auto          # auto | qdrant | memory
QDRANT_URL=http://localhost:6333
QDRANT_COLLECTION=agri_knowledge_v1
AGRI_AI_RAG_TOP_K=3
AGRI_AI_KG_BACKEND=auto           # auto | neo4j | memory
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=neo4j

# ---------------------------------------------------------------------------
# Offline / proxy notes
# ---------------------------------------------------------------------------
# Set to 1 to avoid HuggingFace downloads; vision then uses the mock path.
HF_HUB_OFFLINE=1
TRANSFORMERS_OFFLINE=1
# mock = always use the deterministic mock classifier; auto = try the model.
AGRI_AI_VISION_MODE=auto
# On Windows with a system proxy (Clash etc.), localhost requests may return
# 502. Uncomment in the shell that runs ACIS:
# NO_PROXY=localhost,127.0.0.1
